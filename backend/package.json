{
  "name": "csdl-doanhtrai-backend",
  "version": "1.0.0",
  "description": "Backend NestJS (Modular Monolith) cho hệ thống CSDL Vật chất Doanh trại cấp tỉnh",
  "author": "Nhóm dự án",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:generate": "npm run typeorm -- migration:generate",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "seed:real": "ts-node -r tsconfig-paths/register src/database/seeds/seed-areas-real.ts",
    "seed:geojson": "ts-node -r tsconfig-paths/register src/database/seeds/seed-areas-geojson.ts",
    "seed:asset-catalog": "ts-node -r tsconfig-paths/register src/database/seeds/seed-asset-catalog.ts",
    "seed:official-catalog": "ts-node -r tsconfig-paths/register src/database/seeds/seed-official-catalog.ts",
    "seed:land-parcels": "ts-node -r tsconfig-paths/register src/database/seeds/seed-land-parcels.ts",
    "seed:utilities": "ts-node -r tsconfig-paths/register src/database/seeds/seed-utilities.ts",
    "seed:inventory-catalogs": "ts-node -r tsconfig-paths/register src/database/seeds/seed-inventory-catalogs.ts",
    "seed:local-resources": "ts-node -r tsconfig-paths/register src/database/seeds/seed-local-resources.ts",
    "seed:projects": "ts-node -r tsconfig-paths/register src/database/seeds/seed-projects.ts",
    "seed:budgets": "ts-node -r tsconfig-paths/register src/database/seeds/seed-budgets.ts",
    "seed:tasks": "ts-node -r tsconfig-paths/register src/database/seeds/seed-tasks.ts",
    "seed:oversight": "ts-node -r tsconfig-paths/register src/database/seeds/seed-oversight.ts",
    "seed:legal-docs": "ts-node -r tsconfig-paths/register src/database/seeds/seed-legal-docs.ts",
    "seed:readiness": "ts-node -r tsconfig-paths/register src/database/seeds/seed-readiness.ts",
    "seed:thanh-hoa": "ts-node -r tsconfig-paths/register src/database/seeds/seed-thanh-hoa-full.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
