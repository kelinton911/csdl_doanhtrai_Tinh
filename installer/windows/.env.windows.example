# ==============================================================================
# MẪU BIẾN MÔI TRƯỜNG — BẢN CÀI WINDOWS (OFFLINE)
# install.ps1 sẽ TỰ SINH tệp .env.windows từ mẫu này (thay các chuỗi bí mật bằng
# giá trị ngẫu nhiên an toàn) nếu .env.windows chưa tồn tại.
# Muốn tự cấu hình: sao chép tệp này thành .env.windows rồi chỉnh giá trị.
# TUYỆT ĐỐI KHÔNG commit .env.windows chứa bí mật thật.
# ==============================================================================

# --- CSDL PostgreSQL/PostGIS ---
DB_USER=csdl
DB_PASSWORD=__GENERATE__
DB_NAME=csdl_doanhtrai
DB_PORT_HOST=5433

# --- Redis ---
# (chạy nội bộ mạng container — không publish cổng)

# --- MinIO Object Storage ---
MINIO_USER=csdl
MINIO_PASSWORD=__GENERATE__
MINIO_BUCKET=csdl-documents
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001

# --- Bảo mật JWT (sinh ngẫu nhiên 256-bit) ---
JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cổng dịch vụ trên máy Windows (đổi nếu bị trùng) ---
BACKEND_PORT_HOST=3010
FRONTEND_PORT_HOST=8000
TILE_SERVER_PORT_HOST=8080

# --- CORS: cho phép webapp gọi API ---
CORS_ORIGINS=http://localhost:8000

# --- Tên image trong gói offline (khớp prepare-offline.sh) ---
BACKEND_IMAGE=csdl-doanhtrai-backend:offline
WEBAPP_IMAGE=csdl-doanhtrai-webapp:offline
