# ============================================================
# CSDL Vật chất Doanh trại cấp tỉnh — mẫu biến môi trường
# Sao chép thành `.env` và điều chỉnh. TUYỆT ĐỐI không commit `.env`.
# Bí mật thật quản lý bằng secret store ở môi trường triển khai.
# ============================================================

# --- Cơ sở dữ liệu (PostgreSQL + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=csdl
DB_PASSWORD=csdl_dev_pw
DB_NAME=csdl_doanhtrai

# --- Redis (cache / hàng đợi / outbox) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Object storage (MinIO) ---
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=csdl
MINIO_PASSWORD=csdl_dev_pw
MINIO_BUCKET=csdl-documents

# --- Adminer (chỉ DEV) ---
ADMINER_PORT=8081

# --- Backend (NestJS) ---
NODE_ENV=development
BACKEND_PORT=3000
API_PREFIX=api/v1
# Bí mật ký JWT — thay bằng chuỗi ngẫu nhiên mạnh ở mỗi môi trường.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# CORS: nguồn frontend được phép (mạng nội bộ).
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# --- Frontend (static serve) ---
FRONTEND_PORT=8000
