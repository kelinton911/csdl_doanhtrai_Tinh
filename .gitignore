# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets (NEVER commit real secrets)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Local DB backups (contain real data — NEVER commit)
backups/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/
webapp/test-results/
webapp/playwright-report/
playwright-report/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Docker volumes (local data)
infra/data/

# Log build tự động khi kết thúc session (hook SessionEnd)
.claude-build.log
