{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vietnam Administrative GeoJSON Properties 2026",
  "type": "object",
  "properties": {
    "province_code": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "commune_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "admin_level": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "unit_type": {
      "type": "string"
    },
    "dataset_effective_date": {
      "type": "string",
      "format": "date"
    },
    "geometry_status": {
      "type": "string"
    }
  }
}