# Cấu hình webapp (Vite). Sao chép thành `.env` khi cần ghi đè mặc định.
# Các biến VITE_* được nhúng vào bundle client — KHÔNG đặt bí mật ở đây.

# Cổng backend để Vite proxy /api → backend (DEV/preview). Mặc định http://localhost:3004.
BACKEND_ORIGIN=http://localhost:3004

# Lớp nền bản đồ. Bỏ trống = OpenStreetMap công cộng (chỉ dùng DEV).
# PROD nội bộ: trỏ tile server nội bộ (ROADMAP §5.2), ví dụ:
# VITE_TILE_URL=http://tiles.noibo.lan/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=Bản đồ nội bộ
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
