# ==============================================================================
# TỆP CẤU HÌNH MẪU MÔI TRƯỜNG SẢN XUẤT (PROD) — CSDL VẬT CHẤT DOANH TRẠI TỈNH (P08)
# Hướng dẫn: Chạy `./scripts/generate-prod-secrets.sh` để sinh chuỗi bí mật an toàn,
# sau đó sao chép tệp này thành `.env.production` và điền thông số thật.
# KHÔNG commit tệp `.env.production` chứa mật khẩu thật lên kho mã nguồn.
# ==============================================================================

NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HẠ TẦNG CSDL POSTGRESQL + POSTGIS
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=csdl_doanhtrai_prod
DB_USER=csdl_admin
# Mật khẩu PostgreSQL sản xuất (sinh ngẫu nhiên qua generate-prod-secrets.sh)
DB_PASSWORD=THAY_THE_BANG_MAT_KHAU_MANH_IN_PROD

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH REDIS CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=THAY_THE_BANG_MAT_KHAU_REDIS_MANH

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MINIO OBJECT STORAGE NỘI BỘ
# ------------------------------------------------------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=csdl_minio_admin
MINIO_PASSWORD=THAY_THE_BANG_MAT_KHAU_MINIO_MANH
MINIO_BUCKET=csdl-doanhtrai-documents-prod
MINIO_PUBLIC_URL=http://minio.bochqstinh.bqp:9000

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH BẢO MẬT BẮT BUỘC (JWT & OTP MFA)
# ------------------------------------------------------------------------------
# Khóa bí mật JWT (Tối thiểu 256-bit random hex string)
JWT_ACCESS_SECRET=THAY_THE_BANG_CHUOI_BI_MAT_JWT_ACCESS_256BIT
JWT_REFRESH_SECRET=THAY_THE_BANG_CHUOI_BI_MAT_JWT_REFRESH_256BIT
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Bắt buộc bảo mật 2 lớp TOTP MFA cho tài khoản chỉ huy & quản trị
ENFORCE_TOTP=true
COOKIE_SECRET=THAY_THE_BANG_COOKIE_SECRET_256BIT

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH TƯỜNG LỬA CORS & GIỚI HẠN TẦN SUẤT (RATE LIMIT)
# ------------------------------------------------------------------------------
# Chỉ cho phép các Tên miền / IP nội bộ chính thức được phép kết nối API
CORS_ORIGINS=https://doanhtrai.bochqstinh.bqp,http://10.x.x.x

# Chống tấn công từ chối dịch vụ DoS / Brute-force: 100 request/phút
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH BẢN ĐỒ SỐ GIS OFFLINE (AIR-GAPPED MAP)
# ------------------------------------------------------------------------------
TILE_SERVER_PORT=8080
VITE_TILE_URL=http://localhost:8080/styles/vetsat/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=Bộ CHQS Tỉnh — Máy chủ GIS Nội bộ MQS
